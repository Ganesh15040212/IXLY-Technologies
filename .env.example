# The contact form now posts to a small Node/Express backend in server/,
# which sends email via Gmail SMTP. Configure that backend's credentials in
# server/.env (see server/.env.example) — nothing is needed here for mail.

# Base URL of the contact API, used in production builds where the frontend
# and server/ aren't served from the same origin (dev uses the Vite proxy
# below instead). Leave unset in local dev.
VITE_API_BASE_URL=

# Cloudinary hosting for testimonial videos (see scripts/upload-testimonial-videos.js).
# Cloud name is not secret and is exposed to the browser (it's part of the public
# CDN URL); the API key/secret are only used by the upload script and must never
# get a VITE_ prefix or they'd be bundled into client code.
VITE_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
